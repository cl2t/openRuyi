From: cl2t <yihong.or@isrc.iscas.ac.cn>
Subject: [PATCH] Replace stream exports atomically during account claim refresh

Concurrent refreshes can authorize imports while the exporting account's
stream export map is empty or only partially rebuilt. Those imports stay
invalid when the restored exports compare equal to the previous claim,
leaving connected clients unable to receive messages after a restart.

Build all stream exports, including activation revocations, while holding
the account lock. Keep import and subscription refresh outside the lock.
Add a deterministic regression that pauses export processing and checks
that unchanged stream exports remain authorized throughout the refresh.

Signed-off-by: cl2t <yihong.or@isrc.iscas.ac.cn>
---
--- a/server/accounts.go
+++ b/server/accounts.go
@@ -2637,7 +2637,11 @@
 
 	a.mu.Lock()
 	defer a.mu.Unlock()
-
+	return a.addStreamExportWithAccountPosNoLock(subject, accounts, accountPos)
+}
+
+// Account lock must be held.
+func (a *Account) addStreamExportWithAccountPosNoLock(subject string, accounts []*Account, accountPos uint) error {
 	if a.exports.streams == nil {
 		a.exports.streams = make(map[string]*streamExport)
 	}
@@ -3322,8 +3326,23 @@
 
 	// Reset exports and imports here.
 
-	// Exports is creating a whole new map.
+	// Install the complete stream export map under the account lock. Concurrent
+	// claim refreshes must not authorize imports against a partially rebuilt map.
 	a.exports = exportMap{}
+	streamTokenExpirationChanged := false
+	for _, e := range ac.Exports {
+		if e.Type != jwt.Stream {
+			continue
+		}
+		if err := a.addStreamExportWithAccountPosNoLock(string(e.Subject), authAccounts(e.TokenReq), e.AccountTokenPosition); err != nil {
+			s.Debugf("Error adding stream export to account [%s]: %v", tl, err)
+			continue
+		}
+		if se := a.exports.streams[string(e.Subject)]; se != nil {
+			se.actsRevoked = e.Revocations
+			streamTokenExpirationChanged = streamTokenExpirationChanged || len(e.Revocations) > 0
+		}
+	}
 
 	// Imports are checked unlocked in processInbound, so we can't change out the struct here. Need to process inline.
 	if a.imports.streams != nil {
@@ -3399,17 +3418,13 @@
 
 	jsEnabled := s.JetStreamEnabled()
 
-	streamTokenExpirationChanged := false
 	serviceTokenExpirationChanged := false
 
 	for _, e := range ac.Exports {
 		switch e.Type {
 		case jwt.Stream:
 			s.Debugf("Adding stream export %q for %s", e.Subject, tl)
-			if err := a.addStreamExportWithAccountPos(
-				string(e.Subject), authAccounts(e.TokenReq), e.AccountTokenPosition); err != nil {
-				s.Debugf("Error adding stream export to account [%s]: %v", tl, err.Error())
-			}
+			continue
 		case jwt.Service:
 			s.Debugf("Adding service export %q for %s", e.Subject, tl)
 			rt := Singleton
@@ -3450,11 +3465,6 @@
 
 		a.mu.Lock()
 		switch e.Type {
-		case jwt.Stream:
-			revocationChanged = &streamTokenExpirationChanged
-			if se, ok := a.exports.streams[string(e.Subject)]; ok && se != nil {
-				ea = &se.exportAuth
-			}
 		case jwt.Service:
 			revocationChanged = &serviceTokenExpirationChanged
 			if se, ok := a.exports.services[string(e.Subject)]; ok && se != nil {
--- a/server/jwt_test.go
+++ b/server/jwt_test.go
@@ -7130,3 +7130,45 @@
 		receive(t)
 	}
 }
+
+type jwtStreamExportUpdateLogger struct {
+	DummyLogger
+	entered chan struct{}
+	release chan struct{}
+	once    sync.Once
+}
+
+func (l *jwtStreamExportUpdateLogger) Debugf(format string, args ...any) {
+	if strings.HasPrefix(format, "Adding stream export ") {
+		l.once.Do(func() { close(l.entered) })
+		<-l.release
+	}
+}
+
+func TestJWTStreamExportsRemainAuthorizedDuringClaimRefresh(t *testing.T) {
+	s := RunServer(DefaultOptions())
+	defer s.Shutdown()
+	exporter, err := s.RegisterAccount("exporter")
+	require_NoError(t, err)
+	importer, err := s.RegisterAccount("importer")
+	require_NoError(t, err)
+	claim := jwt.NewAccountClaims(exporter.Name)
+	claim.Exports.Add(&jwt.Export{Subject: "foo.>", Type: jwt.Stream}, &jwt.Export{Subject: "bar.>", Type: jwt.Stream})
+	s.UpdateAccountClaims(exporter, claim)
+	require_True(t, exporter.checkStreamImportAuthorized(importer, "foo.one", nil))
+	require_True(t, exporter.checkStreamImportAuthorized(importer, "bar.one", nil))
+
+	logger := &jwtStreamExportUpdateLogger{entered: make(chan struct{}), release: make(chan struct{})}
+	s.SetLogger(logger, true, false)
+	done := make(chan struct{})
+	go func() { defer close(done); s.UpdateAccountClaims(exporter, claim) }()
+	defer func() { close(logger.release); <-done }()
+	select {
+	case <-logger.entered:
+	case <-time.After(5 * time.Second):
+		t.Fatal("claim refresh did not reach export processing")
+	}
+	// Revalidating an import during an unchanged refresh must not revoke it.
+	require_True(t, exporter.checkStreamImportAuthorized(importer, "foo.one", nil))
+	require_True(t, exporter.checkStreamImportAuthorized(importer, "bar.one", nil))
+}
