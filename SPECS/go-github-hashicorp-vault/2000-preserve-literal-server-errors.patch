From 22b8571f87a7891b3404a976f87f8f24df8a3b38 Mon Sep 17 00:00:00 2001
From: cl2t <yihong.or@isrc.iscas.ac.cn>
Date: Wed, 9 Sep 2026 12:46:26 +0800
Subject: [PATCH] api: preserve literal error messages in ParseSecret

Server-provided error strings are data, not a printf format. Preserve
percent signs and satisfy current Go vet by using a constant format.
Add a regression test covering percent signs and a format verb in the
server response.

Signed-off-by: cl2t <yihong.or@isrc.iscas.ac.cn>
---
 api/secret.go            |  2 +-
 api/secret_error_test.go | 15 +++++++++++++++
 2 files changed, 16 insertions(+), 1 deletion(-)
 create mode 100644 api/secret_error_test.go

diff --git a/api/secret.go b/api/secret.go
index d37bf3c..899bf6f 100644
--- a/api/secret.go
+++ b/api/secret.go
@@ -376,7 +376,7 @@ func ParseSecret(r io.Reader) (*Secret, error) {
 			if err := json.Unmarshal(errBytes, &errStrArray); err != nil {
 				return nil, err
 			}
-			return nil, fmt.Errorf(strings.Join(errStrArray, " "))
+			return nil, fmt.Errorf("%s", strings.Join(errStrArray, " "))
 		}
 
 		// if any raw data is present in resp.Body, add it to secret
diff --git a/api/secret_error_test.go b/api/secret_error_test.go
new file mode 100644
index 0000000..5edae87
--- /dev/null
+++ b/api/secret_error_test.go
@@ -0,0 +1,15 @@
+// SPDX-License-Identifier: MPL-2.0
+
+package api
+
+import (
+	"strings"
+	"testing"
+)
+
+func TestParseSecretErrorPreservesPercent(t *testing.T) {
+	_, err := ParseSecret(strings.NewReader(`{"raw":"data","errors":["usage 100%","retry %s"]}`))
+	if err == nil || err.Error() != "usage 100% retry %s" {
+		t.Fatalf("expected literal server error text, got %v", err)
+	}
+}
